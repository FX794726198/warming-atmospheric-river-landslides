&share
 wrf_core = "ARW", max_dom = 2,
 start_date = "1996-11-15_12:00:00","1996-11-15_12:00:00",
 end_date   = "1996-11-20_00:00:00","1996-11-15_12:00:00",
 interval_seconds = 10800, io_form_geogrid = 2,
/
&geogrid
 parent_id = 1, 1, parent_grid_ratio = 1, 3,
 i_parent_start = 1, 269, j_parent_start = 1, 158,
 e_we = 390, 301, e_sn = 330, 301,
 geog_data_res = "default","default",
 dx = 9000, dy = 9000, map_proj = "lambert",
 ref_lat = 41.0, ref_lon = -138.0, truelat1 = 30.0, truelat2 = 50.0, stand_lon = -138.0,
 geog_data_path = "/path/to/WPS_GEOG",
/
&ungrib
 out_format = "WPS", prefix = "FILE",
/
&metgrid
 fg_name = "FILE", io_form_metgrid = 2,
/
