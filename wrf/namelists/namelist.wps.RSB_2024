&share
 wrf_core = "ARW", max_dom = 2,
 start_date = "2024-04-26_12:00:00","2024-04-26_12:00:00",
 end_date   = "2024-05-03_00:00:00","2024-04-26_12:00:00",
 interval_seconds = 10800, io_form_geogrid = 2,
/
&geogrid
 parent_id = 1, 1, parent_grid_ratio = 1, 3,
 i_parent_start = 1, 189, j_parent_start = 1, 82,
 e_we = 390, 301, e_sn = 390, 301,
 geog_data_res = "default","default",
 dx = 9000, dy = 9000, map_proj = "lambert",
 ref_lat = -24.0, ref_lon = -56.0, truelat1 = -15.0, truelat2 = -35.0, stand_lon = -56.0,
 geog_data_path = "/path/to/WPS_GEOG",
/
&ungrib
 out_format = "WPS", prefix = "FILE",
/
&metgrid
 fg_name = "FILE", io_form_metgrid = 2,
/
